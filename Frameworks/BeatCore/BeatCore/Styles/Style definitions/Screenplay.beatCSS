/*

 Rendering Stylesheet for Beat.
 This is not actual CSS, just uses similar markup.

 Changing values without knowing what you are doing can very
 well cause a crash. Dread lightly.
 
 "Class" names are internal type names, not .typeAsString names.
 
 © Lauri-Matti Parppei 2021-2023

*/

page {
    margin-left: 30 + documentSetting(marginModTop);
    margin-right: 20 + documentSetting(marginModRight);
    margin-top: 36 + documentSetting(marginModTop);
    margin-bottom: 50 + documentSetting(marginModBottom);
    
    margin-bottom-a4: 10;
    margin-bottom-letter: 0;
        
    line-height: 12;
    
    content-padding: 51;
    content-padding-right: 36;
 
    margin-left-a4: 20;
    margin-left-us: 30;
}

titlePage {
    margin-top: 40;
    margin-bottom: 65;
    margin-left: 40;
    margin-right: 40;
    
    line-height: 12;
}

heading {
    width-a4: 60ch - 5ch;
    width-us: 61ch - 5ch;
    
    margin-top: userSetting(sceneHeadingSpacing)l;
    bold: userSetting(headingStyleBold);
    underline: userSetting(headingStyleUnderline);
    
    uppercase: true;
}

section {
    margin-top: userSetting(sceneHeadingSpacing)l;
    bold: true;
    font: userSetting(sectionFontType);
    fontSize: userSetting(sectionFontSize);
    
    if sectionDepth > 2 then fontSize: 12;
    if sectionDepth > 1 then fontSize: userSetting(sectionFontSize) - 2;
    
    min-font-size: 12;
    
    trim: true;
}

synopsis {
    margin-top: 1l;
    italic: true;
    color: darkGray;
    
    font: system;
    font: userSetting(synopsisFontType);
    
    trim: true;
}

action {
    margin-top: 1l;
}

centered {
    margin-top: 1l;
    text-align: center;
    
    trim: true;
}

character {
    margin-left: 19ch;
    margin-top: 1l;
    
    margin-right: 25;
    
    trim: true;
}

parenthetical {
    margin-left: 15ch;
    margin-right: 120;
    margin-top: 0;
    
    trim: true;
}

dialogue {
    margin-top: 0;
    margin-left: 10ch;
    
    margin-right: 110;
    
    trim: true;
}

more {
    margin-left: 136px;
    margin-right: 120;
    margin-top: 0;
}
/*
 dd char
 width-a4: 20ch;
 width-us: 21ch;
 
 dd more
 width-a4: 20ch;
 width-us: 21ch;
 
 dd par
 width-a4: 25ch;
 width-us: 26ch;
 
 dd
 width-a4: 27ch;
 width-us: 28ch;
 */
dualDialogueCharacter {
    trim: true;
    
    margin-top: 1l;
    margin-left: 7ch;
    
    columns: 2;
}
dualDialogueMore {
    margin-top: 0;
    margin-left: 6ch;
    
    columns: 2;
}
dualDialogueParenthetical {
    margin-top: 0;
    margin-left: 4ch;
    
    columns: 2;
    trim: true;
}
dualDialogue {
    margin-left: 0ch;
    margin-right: 1ch;
    
    columns: 2;
    trim: true;
}

transition {
    margin-top: 1l;
    
    text-align: right;
    uppercase: true;
}

lyrics {
    margin-top: 1l;
    text-align: center;
    italic: true;
}

shot {
    uppercase: true;
    
    bold: userSetting(shotStyleBold);
    underline: userSetting(shotStyleUnderline);
    margin-top: 1l;
}

titlePageTitle {
    margin-top: 20l;
    margin-bottom: 2l;
    text-align: center;
    uppercase: true;
}
titlePageAuthor {
    margin-top: 1l;
    text-align: center;
}
titlePageCredit {
    margin-top: 1l;
    text-align: center;
}
titlePageSource {
    margin-top: 1l;
    text-align: center;
}
titlePageContact {
    text-align: left;
}
titlePageDraftDate {
    margin-top: 1l;
    text-align: right;
}
titlePageUnknown {
    margin-top: 1l;
}

note {
    color: gray;
}
