/*

 Editor Stylesheet for Beat.
 This is not actual CSS, just uses similar markup.

 Changing values without knowing what you are doing can very
 well cause a crash. Dread lightly.
 
 "Class" names are internal type names as strings, not .typeAsString names.
 
 Avoid using margin-top values in editor.
 
 © Lauri-Matti Parppei 2021-2022

*/

page {
    margin-left: 30;
    margin-right: 20;
    margin-top: 40;
    margin-bottom: 50;
    margin-bottom-us: 10;
    margin-bottom-a4: 10;
        
    line-height: 15;
    
    content-padding: 51;
    content-padding-right: 36;
 
    margin-left-a4: 20;
    margin-left-us: 29;
}

heading {
    width-a4: 60ch - 2ch;
    width-us: 61ch - 2ch;
    
    bold: userSetting(headingStyleBold);
    underline: userSetting(headingStyleUnderline);
    
    uppercase: true;
}

synopsis {
    font: userSetting(synopsisFontType);
    font-size: 11;
    italic: true;
}

centered {
    text-align: center;
}

character {
    margin-left: 19ch;
    
    margin-right: 25;
}

parenthetical {
    margin-left: 15ch;
    margin-right: 120;
}

dialogue {
    margin-left: 11ch;
    margin-right: 110;
}

more {
    margin-left: 130px;
}

dualDialogueCharacter {
    margin-left: 30ch;
}

dualDialogueParenthetical {
    margin-left: 27ch;
}
dualDialogue {
    margin-left: 21ch;
    margin-right: 0;
}

transition {
    text-align: right;
    uppercase: true;
}

lyrics {
    text-align: center;
    italic: true;
}

shot {
    uppercase: true;
    
    bold: userSetting(headingStyleBold);
}

titlePageUnknown {
    margin-left: 10ch;
}

pageBreak {
    text-align: center;
}

section {
    font: userSetting(sectionFontType);
    fontSize: userSetting(sectionFontSize);
    bold: true;
    
    if sectionDepth > 2 then fontSize: 12;
    if sectionDepth > 1 then fontSize: userSetting(sectionFontSize) - 2;
    
    min-font-size: 12;
}

